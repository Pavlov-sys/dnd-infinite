          {
            "level": 1,
            "name": "Rune Carving",
            "desc": "As a Bonus Action, you carve a rune into a weapon you hold. For 1 minute it deals an extra **1d4 Force** damage on a hit. You can do this a number of times equal to your Intelligence modifier (minimum once), and regain all uses on a Long Rest."
          },
          {
            "level": 2,
            "name": "Runic Ward",
            "desc": "When you take damage, you can use your Reaction to reduce it by 1d10 + your Runeblade level. Once per Short Rest."
          },
          {
            "level": 3,
            "name": "Rune Tradition",
            "desc": "Choose a subclass. You gain its features at level 3 and later levels."
          },
          {
            "level": 5,
            "name": "Extra Attack",
            "desc": "You can attack twice, instead of once, whenever you take the Attack action on your turn."
          },
          {
            "level": 11,
            "name": "Empowered Runes",
            "desc": "Rune Carving now deals an extra 1d8 Force damage."
          },
          {
            "level": 20,
            "name": "Runelord",
            "desc": "Your carved runes last until you dismiss them."
          }
